# Digico Environment Configuration

# Server Port (Default: 8787)
PORT=8787

# Node Environment
NODE_ENV=production

# OpenAI API Key (Required for live WhatsApp AI response generation)
OPENAI_API_KEY=your_openai_api_key_here

# Postgres Database URL (Optional: Leave blank to use embedded file-backed PGlite)
# DATABASE_URL=postgresql://user:password@postgres:5432/digico_db
