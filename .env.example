# =====================================================================
# Digico Monorepo Environment Configuration (.env)
# Root source of truth for website, whatsapp-webhook, and docker containers
# =====================================================================

# Server Port & Node Environment
PORT=8787
NODE_ENV=production

# DeepSeek AI API (https://platform.deepseek.com/api_keys)
# Required for WhatsApp text responses, catalog context, & order tool calling
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# OpenAI Whisper API (https://platform.openai.com/api-keys)
# Optional: Used for transcribing WhatsApp audio voice notes into text
OPENAI_API_KEY=

# Meta WhatsApp Cloud API (https://developers.facebook.com)
# Required for live Meta WhatsApp Cloud API integration
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=digico_secret_verify_token_12345

# MariaDB WooCommerce Database URL
MARIADB_URL=mysql://wp:wp@127.0.0.1:3307/woocommerce_local

# Postgres / PGlite Database URL (Optional: defaults to local file-backed PGlite)
# DATABASE_URL=postgres://user:password@localhost:5432/digico
