+export function parseDraftOrderPayload(json: unknown): DraftOrderPayload | null {
+  let data: unknown;
+  if (typeof json === "string") {
+    try {
+      data = JSON.parse(json);
+    } catch {
+      return null;
+    }
+  } else {
