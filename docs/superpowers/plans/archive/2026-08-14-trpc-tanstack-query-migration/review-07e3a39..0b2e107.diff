+test("parses a valid tool-call arguments string", () => {
+  const payload = parseDraftOrderPayload(
+    '{"productName":"HP 15s","quantity":3,"unitPrice":68500,"totalAmount":205500}',
+  );
+  expect(payload).toEqual({
+    productName: "HP 15s",
+    quantity: 3,
+    unitPrice: 68500,
+    totalAmount: 205500,
+  });
+});
+
+test("parses numeric strings and optional fields", () => {
+  const payload = parseDraftOrderPayload({
+    productName: "Monitor",
+    quantity: "4",
+    unitPrice: "12095",
+    totalAmount: 48380,
+    sku: "MON-24",
+    customerName: "Souhardo Ahmed",
+    phone: "+8801711000001",
+    userConfirmation: true,
+  });
+  expect(payload).toEqual({
+    productName: "Monitor",
+    quantity: 4,
+    unitPrice: 12095,
+    totalAmount: 48380,
+    sku: "MON-24",
+    customerName: "Souhardo Ahmed",
+    phone: "+8801711000001",
+    userConfirmation: true,
+  });
+});
