PORT=8787

# Message/AI-call log storage. Default: file-backed PGlite at ./data/db
# (no setup needed). Set DATABASE_URL to point at a real Postgres server instead.
# DB_DATA_DIR=./data/db
# DATABASE_URL=postgres://user:password@localhost:5432/digico

# You invent this string. Same value in Meta webhook "Verify token".
WHATSAPP_VERIFY_TOKEN=replace-with-a-long-random-string

# Meta → WhatsApp → API Setup (needed to send replies + download voice notes)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# DeepSeek (https://platform.deepseek.com/api_keys)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# OpenAI Whisper — DeepSeek has no speech-to-text API
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
# OPENAI_TRANSCRIBE_MODEL=whisper-1
# OPENAI_TRANSCRIBE_LANGUAGE=bn
# OPENAI_BASE_URL=https://api.openai.com/v1
