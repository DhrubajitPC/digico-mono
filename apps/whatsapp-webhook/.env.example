PORT=8787

# Message/AI-call log storage. Default: file-backed PGlite at ./data/db
# (no setup needed). Set DATABASE_URL to point at a real Postgres server instead.
# DB_DATA_DIR=./data/db
# DATABASE_URL=postgres://user:password@localhost:5432/digico
# MARIADB_URL=mysql://wp:wp@127.0.0.1:3307/woocommerce_local

# You invent this string. Same value in Meta webhook "Verify token".
WHATSAPP_VERIFY_TOKEN=replace-with-a-long-random-string

# Meta → WhatsApp → API Setup (needed to send replies + download voice notes)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# DeepSeek (https://platform.deepseek.com/api_keys)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# ElevenLabs Scribe — voice-note transcription. DeepSeek has no speech-to-text API.
# https://elevenlabs.io/app/settings/api-keys
# Needs a paid plan: the free tier grants no commercial licence and only ~30
# minutes of audio per month.
ELEVENLABS_API_KEY=
# ELEVENLABS_STT_MODEL=scribe_v2
# Leave ELEVENLABS_STT_LANGUAGE unset. Scribe auto-detects and handles
# code-switching, which keeps English product names in Latin script inside
# Bengali speech; pinning it to Bengali transliterates them and breaks the
# catalog search in @digico/db.
# ELEVENLABS_STT_LANGUAGE=ben
